{
  # Weighted chance of rolling each rarity, from 1 Star to 5 Star. The five chances
  # are scaled to add up to 1. The LunaLib settings of the same ids override them
  # when LunaLib is enabled.
  "gacha_1_star_prob": 0.3,
  "gacha_2_star_prob": 0.3,
  "gacha_3_star_prob": 0.2,
  "gacha_4_star_prob": 0.15,
  "gacha_5_star_prob": 0.05,
  # The removal cost as a fraction of the ship's base value. The LunaLib setting
  # of the same id overrides it when LunaLib is enabled.
  "gacha_remove_cost_frac": 0.3,
  # In a Survival Mode game, multiply the removal cost by gacha_survival_fee_mult.
  # The LunaLib setting of the same id overrides gacha_survival_adjustments when
  # LunaLib is enabled. The multiplier is read from this file only.
  "gacha_survival_adjustments": true,
  "gacha_survival_fee_mult": 2.0,
  # In-game days a ship with a gacha hullmod can be missing before its rarity,
  # effects and IVs are deleted. A ship is missing when it is not in any fleet,
  # storage or market.
  "gacha_registry_keep_days": 365,
  # Each ship counts its rolls since its last 5 star, and the roll that reaches this
  # number is always a 5 star. 0 turns the guarantee off.
  "gacha_pity_pulls": 30,
  "plugins": {},
